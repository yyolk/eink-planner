%YAML 1.2
---
name: KDL
file_extensions:
  - kdl
scope: source.kdl
contexts:
  main:
    - match: '//.*'
      scope: comment.line.double-slash.kdl
    - match: '"'
      push: string
    - match: '#(?:true|false|null)\b'
      scope: constant.language.kdl
    - match: '-?(?:\d+\.\d+|\d+)(?:mm|cm|pt|fr|deg|in|em)?'
      scope: constant.numeric.kdl
    - match: '[{}();=,]|\.\.'
      scope: punctuation.kdl
    - match: '[A-Za-z_][A-Za-z0-9_-]*'
      scope: entity.name.tag.kdl
  string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.kdl
    - match: '\\.'
      scope: constant.character.escape.kdl
    - match: '"'
      pop: true
